{
  "id": "com.cunicontrol.app",
  "name": "CuniControl - Gestión Cunícola",
  "short_name": "CuniControl",
  "description": "Sistema profesional de gestión y seguimiento de conejos",
  "lang": "es",
  "dir": "ltr",
  "start_url": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "background_color": "#ffffff",
  "theme_color": "#9b87f5",
  "orientation": "portrait-primary",
  "scope": "/",
  "icons": [
    {
      "src": "https://019bde5a-7925-762c-b579-d66b0faa5e14.mochausercontent.com/pwa-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "https://019bde5a-7925-762c-b579-d66b0faa5e14.mochausercontent.com/pwa-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "screenshots": [
    {
      "src": "https://019bde5a-7925-762c-b579-d66b0faa5e14.mochausercontent.com/screenshot-desktop-1.png",
      "sizes": "1344x768",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Página principal de CuniControl"
    },
    {
      "src": "https://019bde5a-7925-762c-b579-d66b0faa5e14.mochausercontent.com/screenshot-mobile-1.png",
      "sizes": "768x1344",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Dashboard de gestión de conejos"
    }
  ],
  "categories": ["productivity", "business"],
  "share_target": {
    "action": "/",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "media",
          "accept": ["image/*"]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "/",
      "accept": {
        "image/*": [".jpg", ".jpeg", ".png", ".webp"]
      }
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+cunicontrol",
      "url": "/?protocol=%s"
    }
  ],
  "shortcuts": [
    {
      "name": "Añadir Conejo",
      "short_name": "Nuevo",
      "description": "Registrar un nuevo conejo",
      "url": "/?action=add",
      "icons": [
        {
          "src": "https://019bde5a-7925-762c-b579-d66b0faa5e14.mochausercontent.com/pwa-icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "gcm_sender_id": "103953800507",
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "prefer_related_applications": false,
  "related_applications": [
    {
      "platform": "play",
      "id": "com.cunicontrol.app",
      "url": "https://play.google.com/store/apps/details?id=com.cunicontrol.app"
    }
  ],
  "iarc_rating_id": "pending",
  "widgets": [
    {
      "name": "Resumen de Conejos",
      "short_name": "Resumen",
      "description": "Vista rápida del estado de tus conejos",
      "tag": "rabbit_summary",
      "type": "application/vnd.cunicontrol.widget",
      "ms_ac_template": "https://cunicontrol.mocha.app/widget-template.json",
      "data": "https://cunicontrol.mocha.app/api/widgets/summary",
      "screenshots": [
        {
          "src": "https://019bde5a-7925-762c-b579-d66b0faa5e14.mochausercontent.com/screenshot-mobile-1.png",
          "sizes": "768x1344",
          "label": "Widget de resumen"
        }
      ]
    }
  ],
  "edge_side_panel": {
    "preferred_width": 400
  },
  "note_taking": {
    "new_note_url": "/home?action=add_note"
  },
  "scope_extensions": [
    {
      "origin": "https://cunicontrol.mocha.app"
    },
    {
      "origin": "https://cunicontrol.com"
    },
    {
      "origin": "https://*.mocha.app"
    }
  ]
}
